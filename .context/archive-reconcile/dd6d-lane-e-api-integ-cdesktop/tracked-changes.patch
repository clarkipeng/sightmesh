+export const meteredApprovalsApi = {
+  list: async (): Promise<MeteredApprovalLive[]> => {
+    const response = await makeRequest('/api/metered-approvals');
+    return handleApiResponse<MeteredApprovalLive[]>(response);
+  },
+  respond: async (id: string, approved: boolean): Promise<MeteredApprovalLive> => {
+    const response = await makeRequest(`/api/metered-approvals/${id}/respond`, {
+      method: 'POST',
